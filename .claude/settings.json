{
  "permissions": {
    "allow": [
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(gh pr create:*)",
      "Read",
      "Write",
      "Edit"
    ],
    "deny": [
      "Bash(git merge:*)",
      "Bash(git push * main)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(~/.secrets/**)",
      "Edit(~/.secrets/**)"
    ]
  }
}
